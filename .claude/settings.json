{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/pos-edicao.js" }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(node teste_*.js)",
      "Bash(node --check *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(~/.platformio/penv/Scripts/pio.exe run*)",
      "Bash(~/.platformio/penv/Scripts/pio.exe check*)"
    ]
  }
}
